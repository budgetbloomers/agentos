node_modules/
.wrangler/
uploads/
site/build.txt

# Secrets never enter git. The Supabase secret key stays a Worker secret
# (wrangler secret put); a Personal Access Token, if used for a migration,
# lives here only long enough to run it and is then revoked in the dashboard.
.env
.env.*
*.env
supabase/.temp/

# Build output — regenerated by node tools/prepare-site.js; deploy is a direct
# upload of the local site/ dir, so git never needs these (keep _headers + auth-gate.js).
site/index.html
site/pulse/index.html
site/tracker/index.html
site/tracker/vt-mtd-report.html
site/agent/index.html

# Raw exports are AGENT PII (names, ID-ish account numbers, phone, email) and POPIA
# material. They land in the repo root because that is where you drop them; git must
# never take a copy — a single `git add .` would write them into history permanently.
# The data lives in Supabase, and prepare-site/deploy never reads from here.
*.csv
*.xls
*.xlsx
*.zip
# .txt is on this list because of ViciDial's EXPORT_CALL_REPORT — a tab-separated plain-text
# export carrying lead names, phone numbers and email addresses. It lands in the repo root
# like the rest, and until it was added here a `git add .` would have written live customer
# contact details into history permanently. No .txt was tracked when this was added.
*.txt

# Obsidian workspace + vendored community plugin (OBSIDIAN-SYNC.md installs it from the plugin browser)
brain/.obsidian/

# local diagnostics/backups — company data, never in the repo
backups/

# Build output for the prototype preview (regenerated by prepare-site.js)
site/agent-preview/index.html

# The hand-curated team-leader CB map. It is EMPLOYEE DATA — nine real names beside
# their internal codes — and provision-agent-logins.mjs already treats it as untracked
# ("a file that is untracked by git and holds hand-curated numbers"). It has no other
# copy, so the tool writes a dated .bak beside it before every write; that is the
# backup, not this repo. Never `git add -f` it.
specs/team_leader_cbs.json

# Local run scratch: the tick runner log and one-off working files (reports/tmp) are
# regenerated locally and hold company data; never in the repo.
reports/tmp/
reports/*.log

# Agent worktrees Claude Code creates inside the repo — each is its own checkout, never content
.claude/worktrees/

# The 14 Sep Ops audit's raw captures: real agents' sales by username, upload file names and
# screenshots of live pages — company data (the rule above). The audit's write-ups stay tracked.
reports/ops-audit-2026-09-14/vas-state-sept-slice.json
reports/ops-audit-2026-09-14/manifest-recent.json
reports/ops-audit-2026-09-14/after/manifest-recent.json
reports/ops-audit-2026-09-14/pages.json
reports/ops-audit-2026-09-14/pages-mtd.json
reports/ops-audit-2026-09-14/shots/
reports/ops-audit-2026-09-14/shots-mtd/
